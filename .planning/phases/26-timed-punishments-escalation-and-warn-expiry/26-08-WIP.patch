diff --git a/fuku/db/migrations/escalation_migration_test.go b/fuku/db/migrations/escalation_migration_test.go
new file mode 100644
index 0000000..5fa3e4d
--- /dev/null
+++ b/fuku/db/migrations/escalation_migration_test.go
@@ -0,0 +1,191 @@
+package migrations
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"gorm.io/driver/postgres"
+	"gorm.io/gorm"
+	"gorm.io/gorm/logger"
+)
+
+const escalationMigration = "20261122140000_add_escalation_ladder.sql"
+
+// escalationStatements reads the escalation ladder migration and returns the statements the runner
+// would execute, dropping empty and transaction-control statements as applyMigration does.
+func escalationStatements(t *testing.T) []string {
+	t.Helper()
+	path, err := filepath.Abs(filepath.Join("..", "..", "..", "migrations", escalationMigration))
+	if err != nil {
+		t.Fatalf("resolve the migration path: %v", err)
+	}
+	content, err := os.ReadFile(path) // #nosec G304 - fixed repository path
+	if err != nil {
+		t.Fatalf("read %s: %v", escalationMigration, err)
+	}
+	runner := &MigrationRunner{}
+	var run []string
+	for _, stmt := range runner.splitSQLStatements(cleanSupabaseSQL(string(content))) {
+		if strings.TrimSpace(stmt) == "" || isTransactionControlStatement(stmt) {
+			continue
+		}
+		run = append(run, stripSQLComments(stmt))
+	}
+	return run
+}
+
+// TestEscalationMigrationStatements proves, without a database, what the Go runner hands to
+// PostgreSQL for the escalation ladder migration: two idempotent CREATE TABLE statements, the
+// ladder's with its primary key, one check per step and the forget check inline, the counts' with
+// its primary key and count check inline; no transaction control, no CONCURRENTLY, no NOT VALID, no
+// top-level ADD CONSTRAINT and no foreign key; and a file name that sorts after the warn expiry
+// migration, the latest before it.
+func TestEscalationMigrationStatements(t *testing.T) {
+	run := escalationStatements(t)
+	if len(run) != 2 {
+		t.Fatalf("%s gives %d statements, want 2:\n%s", escalationMigration, len(run), strings.Join(run, "\n---\n"))
+	}
+	tables := []struct {
+		prefix      string
+		constraints []string
+	}{
+		{"CREATE TABLE IF NOT EXISTS chat_escalation ", []string{
+			"pk_chat_escalation", "chk_chat_escalation_step1", "chk_chat_escalation_step2", "chk_chat_escalation_step3",
+			"chk_chat_escalation_step4", "chk_chat_escalation_step5", "chk_chat_escalation_forget",
+		}},
+		{"CREATE TABLE IF NOT EXISTS chat_offences ", []string{"pk_chat_offences", "chk_chat_offences_count"}},
+	}
+	for i, table := range tables {
+		if !strings.HasPrefix(run[i], table.prefix) {
+			t.Errorf("statement %d must start with %q, got:\n%s", i+1, table.prefix, run[i])
+		}
+		for _, name := range table.constraints {
+			if !strings.Contains(run[i], "CONSTRAINT "+name+" ") {
+				t.Errorf("statement %d must carry constraint %s inline", i+1, name)
+			}
+		}
+		upper := strings.ToUpper(run[i])
+		for _, banned := range []string{"CONCURRENTLY", "NOT VALID", "BEGIN", "COMMIT", "ROLLBACK", "ADD CONSTRAINT", "REFERENCES"} {
+			if strings.Contains(upper, banned) {
+				t.Errorf("statement %d contains %s", i+1, banned)
+			}
+		}
+	}
+	if escalationMigration <= warnExpiryMigration {
+		t.Errorf("%s must sort after %s", escalationMigration, warnExpiryMigration)
+	}
+}
+
+// TestEscalationMigrationDefaults proves, on PostgreSQL only, that both tables exist after the
+// chain, that the statements run a second time without error, that a ladder row with only chat_id
+// reads off, no steps and 30 days and an offence row with only its key reads 0 and 0, that the
+// named checks refuse a step action outside the set, step seconds over 366 days, a forget period of
+// 0 or 366 and a negative count with SQLSTATE 23514, and that a second row of a key fails with 23505.
+func TestEscalationMigrationDefaults(t *testing.T) {
+	if !strings.EqualFold(strings.TrimSpace(os.Getenv("FUKU_TEST_DATABASE")), "true") {
+		t.Skip("set FUKU_TEST_DATABASE=true and DATABASE_URL to run the escalation migration test on PostgreSQL")
+	}
+	dsn := os.Getenv("DATABASE_URL")
+	if dsn == "" {
+		t.Skip("DATABASE_URL is required to run the escalation migration test on PostgreSQL")
+	}
+	database, err := gorm.Open(postgres.Open(dsn), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	if err != nil {
+		t.Fatalf("open PostgreSQL: %v", err)
+	}
+	sqlDB, err := database.DB()
+	if err != nil {
+		t.Fatalf("get PostgreSQL handle: %v", err)
+	}
+	t.Cleanup(func() { _ = sqlDB.Close() })
+	for _, table := range []string{"chat_escalation", "chat_offences"} {
+		if !database.Migrator().HasTable(table) {
+			t.Fatalf("table %s is missing: the migration chain must run before this test", table)
+		}
+	}
+
+	tx := database.Begin()
+	if tx.Error != nil {
+		t.Fatalf("begin transaction: %v", tx.Error)
+	}
+	// Never committed: the rows below vanish, and so does the second run of the migration.
+	defer func() { _ = tx.Rollback().Error }()
+
+	for i, stmt := range escalationStatements(t) {
+		if err := tx.Exec(stmt).Error; err != nil {
+			t.Fatalf("second run: statement %d failed: %v", i+1, err)
+		}
+	}
+	chat := captchaModeChatID(t)
+	if err := tx.Exec(`INSERT INTO chat_escalation (chat_id) VALUES (?)`, chat).Error; err != nil {
+		t.Fatalf("insert a ladder row with only chat_id: %v", err)
+	}
+	if err := tx.Exec(`INSERT INTO chat_offences (chat_id, user_id) VALUES (?, 7)`, chat).Error; err != nil {
+		t.Fatalf("insert an offence row with only its key: %v", err)
+	}
+	var ladder struct {
+		Enabled    bool
+		Steps      string
+		Secs       int64
+		ForgetDays int
+		UpdatedBy  int64
+	}
+	if err := tx.Raw(`SELECT enabled,
+		step1_action || step2_action || step3_action || step4_action || step5_action AS steps,
+		step1_secs + step2_secs + step3_secs + step4_secs + step5_secs AS secs,
+		forget_days, updated_by FROM chat_escalation WHERE chat_id = ?`, chat).Scan(&ladder).Error; err != nil {
+		t.Fatalf("read the ladder defaults: %v", err)
+	}
+	if ladder.Enabled || ladder.Steps != "" || ladder.Secs != 0 || ladder.ForgetDays != 30 || ladder.UpdatedBy != 0 {
+		t.Errorf("ladder defaults = %+v, want off, no steps, 30 days", ladder)
+	}
+	var offence struct {
+		Offences        int
+		LastOffenceUnix int64
+	}
+	if err := tx.Raw(`SELECT offences, last_offence_unix FROM chat_offences WHERE chat_id = ? AND user_id = 7`, chat).Scan(&offence).Error; err != nil {
+		t.Fatalf("read the offence defaults: %v", err)
+	}
+	if offence.Offences != 0 || offence.LastOffenceUnix != 0 {
+		t.Errorf("offence defaults = %+v, want 0 and 0", offence)
+	}
+
+	refused := func(name, stmt, sqlstate, constraint string) {
+		t.Helper()
+		// A refused statement aborts the transaction in PostgreSQL, so it runs behind a savepoint.
+		if err := tx.Exec("SAVEPOINT refused").Error; err != nil {
+			t.Fatal(err)
+		}
+		err := tx.Exec(stmt, chat).Error
+		if err == nil || !strings.Contains(err.Error(), "SQLSTATE "+sqlstate) || !strings.Contains(err.Error(), constraint) {
+			t.Errorf("%s: err %v, want %s naming %s", name, err, sqlstate, constraint)
+		}
+		if err := tx.Exec("ROLLBACK TO SAVEPOINT refused").Error; err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, tc := range []struct{ name, stmt, constraint string }{
+		{"step1_action warn", `UPDATE chat_escalation SET step1_action = 'warn' WHERE chat_id = ?`, "chk_chat_escalation_step1"},
+		{"step2_secs 31622401", `UPDATE chat_escalation SET step2_secs = 31622401 WHERE chat_id = ?`, "chk_chat_escalation_step2"},
+		{"step5_secs -1", `UPDATE chat_escalation SET step5_secs = -1 WHERE chat_id = ?`, "chk_chat_escalation_step5"},
+		{"forget_days 0", `UPDATE chat_escalation SET forget_days = 0 WHERE chat_id = ?`, "chk_chat_escalation_forget"},
+		{"forget_days 366", `UPDATE chat_escalation SET forget_days = 366 WHERE chat_id = ?`, "chk_chat_escalation_forget"},
+		{"offences -1", `UPDATE chat_offences SET offences = -1 WHERE chat_id = ?`, "chk_chat_offences_count"},
+	} {
+		refused(tc.name, tc.stmt, "23514", tc.constraint)
+	}
+	refused("a second ladder row", `INSERT INTO chat_escalation (chat_id) VALUES (?)`, "23505", "pk_chat_escalation")
+	refused("a second offence row", `INSERT INTO chat_offences (chat_id, user_id) VALUES (?, 7)`, "23505", "pk_chat_offences")
+
+	// The bounds themselves are accepted.
+	for _, stmt := range []string{
+		`UPDATE chat_escalation SET step3_action = 'tban', step3_secs = 31622400, forget_days = 365 WHERE chat_id = ?`,
+		`UPDATE chat_escalation SET step4_action = 'mute', forget_days = 1 WHERE chat_id = ?`,
+	} {
+		if err := tx.Exec(stmt, chat).Error; err != nil {
+			t.Errorf("a value inside the checks was refused: %v\n%s", err, stmt)
+		}
+	}
+}
diff --git a/fuku/db/models/escalation.go b/fuku/db/models/escalation.go
new file mode 100644
index 0000000..c1947b1
--- /dev/null
+++ b/fuku/db/models/escalation.go
@@ -0,0 +1,46 @@
+package models
+
+import "time"
+
+// ChatEscalation is one chat's escalation ladder: whether it is on, up to five steps (an action
+// and, for a timed one, its seconds) and the days after which a member's offence count is
+// forgotten. A chat without a row means off, no steps, 30 days. It is read through the cache key
+// chat_escalation:<chat> (see fuku/db/escalation). The boolean carries no default tag, so a Go
+// false is always written; the check tags build the migration's checks on SQLite too.
+type ChatEscalation struct {
+	ChatId      int64     `gorm:"column:chat_id;primaryKey;autoIncrement:false" json:"chat_id"`
+	Enabled     bool      `gorm:"column:enabled;not null" json:"enabled"`
+	Step1Action string    `gorm:"column:step1_action;not null;size:8;check:chk_chat_escalation_step1,step1_action IN ('', 'mute', 'tmute', 'kick', 'tban', 'ban') AND step1_secs BETWEEN 0 AND 31622400" json:"step1_action"`
+	Step1Secs   int       `gorm:"column:step1_secs;not null" json:"step1_secs"`
+	Step2Action string    `gorm:"column:step2_action;not null;size:8;check:chk_chat_escalation_step2,step2_action IN ('', 'mute', 'tmute', 'kick', 'tban', 'ban') AND step2_secs BETWEEN 0 AND 31622400" json:"step2_action"`
+	Step2Secs   int       `gorm:"column:step2_secs;not null" json:"step2_secs"`
+	Step3Action string    `gorm:"column:step3_action;not null;size:8;check:chk_chat_escalation_step3,step3_action IN ('', 'mute', 'tmute', 'kick', 'tban', 'ban') AND step3_secs BETWEEN 0 AND 31622400" json:"step3_action"`
+	Step3Secs   int       `gorm:"column:step3_secs;not null" json:"step3_secs"`
+	Step4Action string    `gorm:"column:step4_action;not null;size:8;check:chk_chat_escalation_step4,step4_action IN ('', 'mute', 'tmute', 'kick', 'tban', 'ban') AND step4_secs BETWEEN 0 AND 31622400" json:"step4_action"`
+	Step4Secs   int       `gorm:"column:step4_secs;not null" json:"step4_secs"`
+	Step5Action string    `gorm:"column:step5_action;not null;size:8;check:chk_chat_escalation_step5,step5_action IN ('', 'mute', 'tmute', 'kick', 'tban', 'ban') AND step5_secs BETWEEN 0 AND 31622400" json:"step5_action"`
+	Step5Secs   int       `gorm:"column:step5_secs;not null" json:"step5_secs"`
+	ForgetDays  int       `gorm:"column:forget_days;not null;check:chk_chat_escalation_forget,forget_days BETWEEN 1 AND 365" json:"forget_days"`
+	UpdatedBy   int64     `gorm:"column:updated_by;not null" json:"updated_by"`
+	UpdatedAt   time.Time `gorm:"column:updated_at" json:"updated_at,omitempty"`
+}
+
+// TableName returns the migration's table name.
+func (ChatEscalation) TableName() string {
+	return "chat_escalation"
+}
+
+// ChatOffence is one member's offence count in one chat and the unix second of the last counted
+// offence. It is written only by escalation.CountOffence's conditional upsert, never cached, and
+// never part of backup, export, import or reset.
+type ChatOffence struct {
+	ChatId          int64 `gorm:"column:chat_id;primaryKey;autoIncrement:false" json:"chat_id"`
+	UserId          int64 `gorm:"column:user_id;primaryKey;autoIncrement:false" json:"user_id"`
+	Offences        int   `gorm:"column:offences;not null;check:chk_chat_offences_count,offences >= 0" json:"offences"`
+	LastOffenceUnix int64 `gorm:"column:last_offence_unix;not null" json:"last_offence_unix"`
+}
+
+// TableName returns the migration's table name.
+func (ChatOffence) TableName() string {
+	return "chat_offences"
+}
diff --git a/migrations/20261122140000_add_escalation_ladder.sql b/migrations/20261122140000_add_escalation_ladder.sql
new file mode 100644
index 0000000..1108898
--- /dev/null
+++ b/migrations/20261122140000_add_escalation_ladder.sql
@@ -0,0 +1,53 @@
+-- The escalation ladder (chat_escalation) and the offence counts behind it (chat_offences).
+--
+-- chat_escalation holds one chat's ladder, one row per chat whose owner changed it in the
+-- private settings menu: whether it is on, up to five steps (an action of '', mute, tmute, kick,
+-- tban or ban, and its seconds, 0 for an untimed action, at most 366 days) and the number of days
+-- after which a member's count is forgotten (1 to 365, default 30). A chat without a row means
+-- off, no steps, 30 days. It is read through the cache key chat_escalation:<chat>, which skips the
+-- in-process layer, and every write drops that key.
+--
+-- chat_offences holds one member's offence count in one chat and the unix second of the last
+-- counted offence. It is written only by the one conditional upsert of escalation.CountOffence,
+-- so every replica counts one offence once, is never cached, and is never pruned by a worker: a
+-- count is forgotten by comparison inside that upsert. Times are unix seconds, so no dialect
+-- compares text times.
+--
+-- Neither table has a foreign key on the chat (the staff and settings precedent) or is part of
+-- backup, export, import or reset. Both statements are idempotent and their constraints are
+-- inline, because both migration appliers swallow duplicate_object on a bare constraint addition;
+-- the file runs unchanged in one transaction under either applier.
+
+CREATE TABLE IF NOT EXISTS chat_escalation (
+    chat_id BIGINT NOT NULL,
+    enabled BOOLEAN NOT NULL DEFAULT FALSE,
+    step1_action VARCHAR(8) NOT NULL DEFAULT '',
+    step1_secs INTEGER NOT NULL DEFAULT 0,
+    step2_action VARCHAR(8) NOT NULL DEFAULT '',
+    step2_secs INTEGER NOT NULL DEFAULT 0,
+    step3_action VARCHAR(8) NOT NULL DEFAULT '',
+    step3_secs INTEGER NOT NULL DEFAULT 0,
+    step4_action VARCHAR(8) NOT NULL DEFAULT '',
+    step4_secs INTEGER NOT NULL DEFAULT 0,
+    step5_action VARCHAR(8) NOT NULL DEFAULT '',
+    step5_secs INTEGER NOT NULL DEFAULT 0,
+    forget_days INTEGER NOT NULL DEFAULT 30,
+    updated_by BIGINT NOT NULL DEFAULT 0,
+    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
+    CONSTRAINT pk_chat_escalation PRIMARY KEY (chat_id),
+    CONSTRAINT chk_chat_escalation_step1 CHECK (step1_action IN ('', 'mute', 'tmute', 'kick', 'tban', 'ban') AND step1_secs BETWEEN 0 AND 31622400),
+    CONSTRAINT chk_chat_escalation_step2 CHECK (step2_action IN ('', 'mute', 'tmute', 'kick', 'tban', 'ban') AND step2_secs BETWEEN 0 AND 31622400),
+    CONSTRAINT chk_chat_escalation_step3 CHECK (step3_action IN ('', 'mute', 'tmute', 'kick', 'tban', 'ban') AND step3_secs BETWEEN 0 AND 31622400),
+    CONSTRAINT chk_chat_escalation_step4 CHECK (step4_action IN ('', 'mute', 'tmute', 'kick', 'tban', 'ban') AND step4_secs BETWEEN 0 AND 31622400),
+    CONSTRAINT chk_chat_escalation_step5 CHECK (step5_action IN ('', 'mute', 'tmute', 'kick', 'tban', 'ban') AND step5_secs BETWEEN 0 AND 31622400),
+    CONSTRAINT chk_chat_escalation_forget CHECK (forget_days BETWEEN 1 AND 365)
+);
+
+CREATE TABLE IF NOT EXISTS chat_offences (
+    chat_id BIGINT NOT NULL,
+    user_id BIGINT NOT NULL,
+    offences INTEGER NOT NULL DEFAULT 0,
+    last_offence_unix BIGINT NOT NULL DEFAULT 0,
+    CONSTRAINT pk_chat_offences PRIMARY KEY (chat_id, user_id),
+    CONSTRAINT chk_chat_offences_count CHECK (offences >= 0)
+);
