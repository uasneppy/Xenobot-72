# Debug image with full shell access for troubleshooting
# Multi-stage build to keep image size reasonable while preserving debug symbols

# Stage 1: Build using native platform
FROM --platform=$BUILDPLATFORM golang:alpine AS builder

ARG TARGETOS
ARG TARGETARCH

RUN apk add --no-cache curl wget gnupg git
WORKDIR /app

# Copy go mod files first for better layer caching
COPY go.mod go.sum ./

# Download dependencies - runs on native platform, cached unless go.mod/go.sum change
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod download && go mod verify

# Copy source code
COPY . .

# Build the binary (debug mode - no optimization flags, preserves symbols)
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -trimpath \
    -o xenobot-72 .

# Stage 2: Alpine runtime with shell access
FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

# Copy binary and migrations
COPY --from=builder /app/xenobot-72 /app/xenobot-72
COPY --from=builder /app/migrations /app/migrations

# Create non-root user
RUN addgroup -g 65532 -S xenobot && \
    adduser -u 65532 -S xenobot -G xenobot && \
    chown -R xenobot:xenobot /app

USER xenobot:xenobot

EXPOSE 8080

ENTRYPOINT ["/app/xenobot-72"]

# Metadata
LABEL org.opencontainers.image.source="https://github.com/uasneppy/Xenobot-72"
LABEL org.opencontainers.image.title="Xenobot-72"
LABEL org.opencontainers.image.description="Xenobot-72 Debug Docker Image"
